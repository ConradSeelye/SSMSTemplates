/*
AG Automatic Seeding Status
3/19/2022

* Be aware of time-zone differences.
* Multiple frequent views of this query might show no changes, but behind the scenes there might still be progress. 

https://learn.microsoft.com/en-us/sql/database-engine/availability-groups/windows/automatically-initialize-always-on-availability-group?view=sql-server-ver15#sysdm_hadr_automatic_seeding


*/

SELECT 
	local_database_name AS DatabaseName,
	remote_machine_name AS Server,
	FORMAT(CAST(transferred_size_bytes AS DECIMAL (16)) / CAST(database_size_bytes AS DECIMAL (16)), 'P') AS Percent_Transfered,
	FORMAT(transferred_size_bytes, '###,###') transferred_size_bytes,
	DATEADD(HH,-7,estimate_time_complete_utc) AS Estimated_Completion_Time_PDT,
	-- CAST(database_size_bytes AS DECIMAL (16)) / CAST(transfer_rate_bytes_per_second AS DECIMAL (16)) / 60 / 60 AS Total_Hours_Estimate, 
	-- CAST((CAST(database_size_bytes AS DECIMAL (16)) / CAST(transfer_rate_bytes_per_second AS DECIMAL (16)) / 60 / 60) AS decimal(10,1)) AS Total_Hours_Estimate, 
	CAST((CAST(database_size_bytes AS DECIMAL (16)) / CAST(NULLIF(transfer_rate_bytes_per_second, 0) AS DECIMAL (16)) / 60 / 60) AS decimal(10,1)) AS Total_Hours_Estimate, 
	FORMAT(transfer_rate_bytes_per_second , '###,###')  transfer_rate_bytes_per_second,
	'-----------' AS '-----------',
	*
	FROM sys.dm_hadr_physical_seeding_stats
	ORDER BY 1, 2
	
