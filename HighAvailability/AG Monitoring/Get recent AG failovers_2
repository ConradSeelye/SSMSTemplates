/*
Get recent AG failovers_2

* Notes
1.	Value of error log file you want to read: 0 = current, 1 = Archive #1, 2 = Archive #2, etc…
2.	Log file type: 1 or NULL = error log, 2 = SQL Agent log
3.	Search string 1: String one you want to search for
4.	Search string 2: String two you want to search for to further refine the results
5.	Search from start time
6.	Search to end time
7.	Sort order for results: N’asc’ = ascending, N’desc’ = descending



*/

DECLARE @DateTimeEnd VARCHAR(100) = CONVERT(VARCHAR(100), GetDate(), 120)
DECLARE @DateTimeStart VARCHAR(100) = CONVERT(VARCHAR(100), DATEADD (MINUTE,-2,@DateTimeEnd), 120)
DECLARE @Text1 VARCHAR(MAX) = 'PRIMARY_NORMAL'
DECLARE @RecentFailover bit = 0
DECLARE @CurrentBackupJobRunning bit = 0

CREATE TABLE #ErrorLog (
    LogDate DATETIME,
    ProcessInfo NVARCHAR(128),
    Text NVARCHAR(MAX)
);

INSERT INTO #ErrorLog
EXEC master.dbo.xp_readerrorlog 
	0 
	, 1
	, "PRIMARY_NORMAL"
	, NULL
	, @DateTimeStart
	, @DateTimeEnd
	, N'DESC'
	-- , @InstanceName 

